# Telegram Bot API token for initData verification and savePreparedInlineMessage.
# Never expose to the client. Never commit a real value.
TELEGRAM_BOT_TOKEN=

# Public bot username without @ (BotFather username). Used for Template Share deep links.
TELEGRAM_BOT_USERNAME=

# PC-02 device probe (isolated). Leave unset/disabled in production unless running the probe.
# Set PC02_PROBE_ENABLED=1 only on a controlled deploy/process. Never commit real Telegram user ids.
# PC02_PROBE_ENABLED=0
# PC02_PROBE_TEST_SENDER_ID=
# PC02_PROBE_TEST_RECEIVER_ID=
# PC02_PROBE_URL_MODE=startapp
# Optional control mode for comparison: startapp | start


# Runtime environment. production / APP_ENV=production disables development auth.
NODE_ENV=development
APP_ENV=development

# HTTP listen. Railway sets PORT. Set HOST=0.0.0.0 on Railway (main also defaults to 0.0.0.0 when production).
PORT=8787
HOST=127.0.0.1

# Development-only authentication. Ignored when NODE_ENV=production or APP_ENV=production.
IDENTITY_ALLOW_DEV_AUTH=false
IDENTITY_DEV_AUTH_SECRET=

# Optional operator note: HTTPS origin of this temporary TEST UI host (BotFather Web App URL).
# Not required by application code; configure the same URL in BotFather after Railway assigns it.
# PUBLIC_APP_URL=

# Server-side RIM provider configuration. Parsed separately from runtime selection.
# Unset or fake keeps fake mode. openai requires OPENAI_API_KEY and OPENAI_MODEL.
# OPENAI_API_KEY is server-side only. Never expose it to Mini App code.
# Never commit a real key. Never commit a production model name.
RIM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
